@page "/TiposCompra/agregar"
@page "/TiposCompra/agregar/{IdTipoCompra:int?}"

@using EncuestasInterfer.Models
@using EncuestasInterfer.Services.TiposCompraServices
@using MudBlazor

@inject ITiposCompraServices tipocompraServices
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <h3 style="margin-bottom: 20px;">@(IdTipoCompra.HasValue ? "Editar Tipo de Compra" : "Nuevo Tipo de Compra")</h3>

    <MudPaper Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4 text-center" Align="Align.Center">
            @(IdTipoCompra.HasValue ? "Editar Tipo de Compra" : "Agregar Tipo de Compra")
        </MudText>

        <EditForm Model="tcompra" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Tipo de Compra"
                                  @bind-Value="tcompra.NombreTipoCompra"
                                  For="@(() => tcompra.NombreTipoCompra)"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="El tipo de compra es requerido"
                                  MaxLength="100"
                                  Counter="100"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-content-between mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("/TiposCompra"))">
                    Regresar
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Guardando...</MudText>
                    }
                    else
                    {
                        <MudText>@(IdTipoCompra.HasValue ? "Actualizar" : "Guardar")</MudText>
                    }
                </MudButton>
            </div>

        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public int? IdTipoCompra { get; set; }

    private TiposCompra tcompra = new TiposCompra();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (IdTipoCompra.HasValue)
        {
            try
            {
                tcompra = await tipocompraServices.GetByIdAsync(IdTipoCompra.Value);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al cargar el tipo de compra: {ex.Message}", Severity.Error);
                NavigationManager.NavigateTo("/TiposCompra");
            }
        }
        else
        {
            tcompra = new TiposCompra();
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var result = await tipocompraServices.AddUpdateAsync(tcompra);

            if (result)
            {
                var message = IdTipoCompra.HasValue ? "Tipo de Compra actualizado correctamente" : "Tipo de Compra creado correctamente";
                Snackbar.Add(message, Severity.Success);
                NavigationManager.NavigateTo("/TiposCompra");
            }
            else
            {
                Snackbar.Add("Error al guardar el Tipo de Compra", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}