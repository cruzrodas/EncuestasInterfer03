@page "/Pregunta/detalle/{IdPregunta:int}"

@using EncuestasInterfer.Models
@using EncuestasInterfer.Services.PreguntasServices
@using MudBlazor

@inject IPreguntasServices preguntaServices
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    @if (isLoading)
    {
        <div class="spinner-container">
            <img src="/images/world-spinner.gif" alt="Cargando..." class="spinner-image" />
        </div>
    }
    else if (pregunta == null)
    {
        <MudAlert Severity="Severity.Error">No se encontró la pregunta</MudAlert>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <MudText Typo="Typo.h4">Detalle de Pregunta</MudText>
                @if (pregunta.Activa == true)
                {
                    <MudChip T="string" Color="Color.Success">Activa</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default">Inactiva</MudChip>
                }
            </div>

            <MudDivider Class="mb-4" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">ID:</MudText>
                    <MudText>@pregunta.IdPregunta</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Fecha de Creación:</MudText>
                    <MudText>@pregunta.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Encuesta:</MudText>
                    <MudText>@pregunta.IdEncuestaNavigation?.Titulo</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Tipo de Pregunta:</MudText>
                    <MudText>@pregunta.IdTipoPreguntaNavigation?.NombreTipoPregunta</MudText>
                    @if (!string.IsNullOrEmpty(pregunta.IdTipoPreguntaNavigation?.Descripcion))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @pregunta.IdTipoPreguntaNavigation.Descripcion
                        </MudText>
                    }
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Pregunta:</MudText>
                    <MudText Class="mt-2" Style="font-size: 1.1em;">@pregunta.TextoPregunta</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            @* Mostrar opciones si las hay *@
            @if (pregunta.OpcionRespuesta != null && pregunta.OpcionRespuesta.Any())
            {
                <MudText Typo="Typo.h6" Class="mb-3">Opciones de Respuesta</MudText>

                <MudTable Items="@pregunta.OpcionRespuesta" Hover="true" Bordered="true" Dense="true">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Opción</MudTh>
                        <MudTh>Valor Numérico</MudTh>
                        <MudTh>Estado</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="opcion">
                        <MudTd DataLabel="#">@(pregunta.OpcionRespuesta.ToList().IndexOf(opcion) + 1)</MudTd>
                        <MudTd DataLabel="Opción">@opcion.TextoOpcion</MudTd>
                        <MudTd DataLabel="Valor Numérico">
                            @(opcion.ValorNumerico.HasValue ? opcion.ValorNumerico.Value.ToString() : "-")
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            @if (opcion.Activa == true)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Activa</MudChip>
                            }
                            else
                            {
                                <MudChip T="string"  Color="Color.Default" Size="Size.Small">Inactiva</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudDivider Class="my-4" />
            }
            else if (pregunta.IdTipoPreguntaNavigation?.RequiereOpciones == true)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Esta pregunta requiere opciones pero aún no tiene ninguna asociada.
                </MudAlert>
            }

            <div class="d-flex justify-content-between mt-4">
                <MudButton Variant="MudVariant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo($"/Pregunta/{pregunta.IdEncuesta}"))">
                    Regresar
                </MudButton>

                <div>
                    <MudButton Variant="MudVariant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.List"
                               OnClick="@(() => NavigationManager.NavigateTo($"/Encuesta/detalle/{pregunta.IdEncuesta}"))">
                        Ver Encuesta
                    </MudButton>
                    <MudButton Variant="MudVariant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => NavigationManager.NavigateTo($"/Pregunta/agregar/{IdPregunta}"))">
                        Editar Pregunta
                    </MudButton>
                </div>
            </div>
        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter] public int IdPregunta { get; set; }

    private Pregunta? pregunta;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPregunta();
    }

    private async Task LoadPregunta()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            pregunta = await preguntaServices.GetByIdWithOpcionesAsync(IdPregunta);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar la pregunta: {ex.Message}", Severity.Error);
            pregunta = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
