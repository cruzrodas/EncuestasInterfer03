@page "/Nacionalidad/agregar"
@page "/Nacionalidad/agregar/{IdNacionalidad:int?}"

@using EncuestasInterfer.Models
@using EncuestasInterfer.Services.NacionalidadServices
@using MudBlazor

@inject INacionalidadService nacionalidadServices
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <h3 style="margin-bottom: 20px;">@(IdNacionalidad.HasValue ? "Editar Nacionalidad" : "Nueva Nacionalidad")</h3>

    <MudPaper Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4 text-center" Align="Align.Center">
            @(IdNacionalidad.HasValue ? "Editar Nacionalidad" : "Agregar Nacionalidad")
        </MudText>

        <EditForm Model="nacionalidad" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nombre del País"
                                  @bind-Value="nacionalidad.NombrePais"
                                  For="@(() => nacionalidad.NombrePais)"
                                  Variant="MudVariant.Outlined"
                                  Required="true"
                                  RequiredError="El nombre del país es requerido"
                                  MaxLength="100"
                                  Counter="100"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-content-between mt-4">
                <MudButton Variant="MudVariant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("/Nacionalidad"))">
                    Regresar
                </MudButton>

                <MudButton ButtonType="MudBlazor.ButtonType.Submit"
                           Variant="MudVariant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Guardando...</MudText>
                    }
                    else
                    {
                        <MudText>@(IdNacionalidad.HasValue ? "Actualizar" : "Guardar")</MudText>
                    }
                </MudButton>
            </div>

        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public int? IdNacionalidad { get; set; }

    private Nacionalidad nacionalidad = new Nacionalidad();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (IdNacionalidad.HasValue)
        {
            try
            {
                nacionalidad = await nacionalidadServices.GetByIdAsync(IdNacionalidad.Value);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al cargar la nacionalidad: {ex.Message}", Severity.Error);
                NavigationManager.NavigateTo("/Nacionalidad");
            }
        }
        else
        {
            nacionalidad = new Nacionalidad();
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var result = await nacionalidadServices.AddUpdateAsync(nacionalidad);

            if (result)
            {
                var message = IdNacionalidad.HasValue ? "Nacionalidad actualizada correctamente" : "Nacionalidad creada correctamente";
                Snackbar.Add(message, Severity.Success);
                NavigationManager.NavigateTo("/Nacionalidad");
            }
            else
            {
                Snackbar.Add("Error al guardar la Nacionalidad", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}