@page "/MotivoVisita/agregar"
@page "/MotivoVisita/agregar/{IdMotivoVisita:int?}"

@using EncuestasInterfer.Models
@using EncuestasInterfer.Services.MotivoVisitaService
@using MudBlazor

@inject IMotivoVisitaServices motivoVisitaServices
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <h3 style="margin-bottom: 20px;">@(IdMotivoVisita.HasValue ? "Editar Motivo de Visita" : "Nuevo Motivo de Visita")</h3>

    <MudPaper Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4 text-center" Align="Align.Center">
            @(IdMotivoVisita.HasValue ? "Editar Motivo de Visita" : "Agregar Motivo de Visita")
        </MudText>

        <EditForm Model="motivoVisita" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Motivo de Visita"
                                  @bind-Value="motivoVisita.NombreMotivo"
                                  For="@(() => motivoVisita.NombreMotivo)"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="El motivo de visita es requerido"
                                  MaxLength="100"
                                  Counter="100"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-content-between mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("/MotivoVisita"))">
                    Regresar
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Guardando...</MudText>
                    }
                    else
                    {
                        <MudText>@(IdMotivoVisita.HasValue ? "Actualizar" : "Guardar")</MudText>
                    }
                </MudButton>
            </div>

        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public int? IdMotivoVisita { get; set; }

    private MotivoVisita motivoVisita = new MotivoVisita();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (IdMotivoVisita.HasValue)
        {
            try
            {
                motivoVisita = await motivoVisitaServices.GetByIdAsync(IdMotivoVisita.Value);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al cargar el motivo de visita: {ex.Message}", Severity.Error);
                NavigationManager.NavigateTo("/MotivoVisita");
            }
        }
        else
        {
            motivoVisita = new MotivoVisita();
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var result = await motivoVisitaServices.AddUpdateAsync(motivoVisita);

            if (result)
            {
                var message = IdMotivoVisita.HasValue ? "Motivo de Visita actualizado correctamente" : "Motivo de Visita creado correctamente";
                Snackbar.Add(message, Severity.Success);
                NavigationManager.NavigateTo("/MotivoVisita");
            }
            else
            {
                Snackbar.Add("Error al guardar el Motivo de Visita", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
